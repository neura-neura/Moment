{
  "name": "moment",
  "version": "1.3.0",
  "private": true,
  "scripts": {
    "build": "npm run build:app",
    "verify": "npm run build:app && npm run smoke:app",
    "build:app": "dotnet build Moment.App/Moment.App.csproj -c Release -p:Platform=x64 -p:PublishReadyToRun=false -p:PublishTrimmed=false",
    "smoke:app": "dotnet run --project Moment.App/Smoke/NativeSmoke.csproj -c Release",
    "publish:app": "dotnet publish Moment.App/Moment.App.csproj -c Release -p:Platform=x64 -p:PublishProfile=win-x64 -p:PublishReadyToRun=false -p:PublishTrimmed=false",
    "package:app": "powershell -NoProfile -ExecutionPolicy Bypass -File Moment.App/installer/Build-Installer.ps1"
  }
}
